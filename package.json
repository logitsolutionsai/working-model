{
  "name": "working-model",
  "version": "0.1.0",
  "description": "Ask how anything works. Get a working model: an animated explainer you can play with, where every claim is a passing test.",
  "type": "module",
  "license": "MIT",
  "author": "Logit Solutions AI",
  "homepage": "https://github.com/logitsolutionsai/working-model",
  "repository": {
    "type": "git",
    "url": "https://github.com/logitsolutionsai/working-model.git"
  },
  "bin": {
    "working-model": "scripts/working-model.mjs"
  },
  "files": [
    "scripts/",
    "src/",
    "schema/",
    "examples/",
    "references/",
    "SKILL.md",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "node --test \"tests/*.test.mjs\"",
    "test:e2e": "node --test --test-concurrency=1 \"tests/e2e/*.e2e.mjs\"",
    "check:examples": "node scripts/working-model.mjs check examples/",
    "gallery": "node scripts/working-model.mjs gallery --thumbs"
  },
  "keywords": [
    "agent-skill",
    "claude-code",
    "explainer",
    "simulation",
    "interactive",
    "property-based-testing",
    "visualization"
  ],
  "devDependencies": {
    "playwright-core": "1.65.0"
  }
}
